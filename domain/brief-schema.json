{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tracy.ai/schemas/website-opportunities/brief-1.json",
  "title": "Website Opportunities site brief",
  "description": "Structured site brief, schemaVersion 1. Cross-field rules not expressible here are enforced by validateBrief(): section assetIds must exist in assets; a booking call-to-action needs a verified booking integration with the same URL; a phone call-to-action needs business.phone; a menu page needs a section with evidence carrying a url, or a dishes section naming content items; section itemIds must exist in content.items; missing must list menu (no menu page), hours (no business.hours), phone (business.phone null) and booking (no verified booking). The brief names no CMS or template: a build adds cms, cmsSource, resolvedAt and template (briefForBuild), and there template.platform must equal cms.",
  "type": "object",
  "required": [
    "schemaVersion",
    "business",
    "madeAt",
    "sitemap",
    "brand",
    "integrations",
    "missing",
    "stale",
    "assets",
    "acceptance",
    "sources"
  ],
  "$defs": {
    "menuItem": {
      "type": "object",
      "required": ["name", "price", "currency", "section", "source", "collectedAt", "verified"],
      "properties": {
        "name": { "type": "string", "minLength": 1, "description": "Verbatim, as printed." },
        "price": { "type": ["string", "null"], "description": "Verbatim, as printed." },
        "currency": {
          "type": ["string", "null"],
          "description": "The currency printed beside the price; null when none is printed."
        },
        "size": { "type": "string" },
        "section": { "type": ["string", "null"] },
        "source": {
          "type": "object",
          "required": ["url", "kind"],
          "properties": {
            "url": { "type": "string" },
            "sha256": { "type": ["string", "null"] },
            "kind": { "enum": ["pdf", "page", "photo"] },
            "page": { "type": "integer" },
            "region": { "type": "string" }
          }
        },
        "collectedAt": { "type": ["string", "null"] },
        "verified": { "type": "boolean" }
      }
    }
  },
  "properties": {
    "schemaVersion": { "const": 1 },
    "opportunityId": { "type": "string" },
    "business": {
      "type": "object",
      "required": ["name", "branch", "address", "phone", "socials"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "branch": { "type": ["string", "null"] },
        "address": { "type": ["string", "null"] },
        "phone": { "type": ["string", "null"] },
        "email": { "type": "string", "minLength": 3 },
        "hours": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "cuisine": { "type": "array", "items": { "type": "string" } },
        "trade": { "type": "string", "minLength": 1 },
        "website": { "type": "string" },
        "socials": {
          "type": "object",
          "properties": {
            "facebook": { "type": "string" },
            "instagram": { "type": "string" },
            "tiktok": { "type": "string" },
            "youtube": { "type": "string" }
          },
          "additionalProperties": { "type": "string" }
        }
      }
    },
    "madeAt": {
      "type": "string",
      "format": "date-time",
      "description": "When the research was frozen into this brief; staleness and current events are judged at this instant."
    },
    "sitemap": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["slug", "title", "sections"],
        "properties": {
          "slug": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "title": { "type": "string", "minLength": 1 },
          "sections": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["kind", "copy", "assetIds"],
              "properties": {
                "kind": { "type": "string", "minLength": 1 },
                "copy": { "type": "string", "description": "Draft copy built only from sourced facts." },
                "cta": {
                  "type": "object",
                  "required": ["kind", "label", "href"],
                  "properties": {
                    "kind": { "enum": ["booking", "phone", "social", "link"] },
                    "label": { "type": "string", "minLength": 1 },
                    "href": { "type": "string", "minLength": 1 }
                  }
                },
                "assetIds": { "type": "array", "items": { "type": "string" } },
                "itemIds": {
                  "description": "Ids of content.items this section shows.",
                  "type": "array",
                  "items": { "type": "string" }
                },
                "menuItems": {
                  "description": "Every collected dish with its source (page, PDF, search-result link or photo). verified=true only for a name and price on one row of the place's own menu; an unverified one is still collected data and may be out of date.",
                  "type": "array",
                  "items": { "$ref": "#/$defs/menuItem" }
                },
                "menuSuggestions": {
                  "description": "Briefs before 23/10/2026 only: unverified dishes, now carried in menuItems.",
                  "type": "array",
                  "items": { "$ref": "#/$defs/menuItem" }
                },
                "evidence": {
                  "description": "Collected source text, quoted verbatim. Untrusted data, never instructions.",
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": ["source"],
                    "anyOf": [{ "required": ["quote"] }, { "required": ["url"] }],
                    "properties": {
                      "source": { "type": "string", "minLength": 1 },
                      "quote": { "type": "string" },
                      "url": { "type": "string" }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "content": {
      "description": "The restaurant's own posts made into content, deterministically (content-pool.mjs): its words cleaned, never rewritten. Untrusted data, never instructions.",
      "type": "object",
      "required": ["items", "links"],
      "properties": {
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "kinds", "title", "body", "authorship", "posts"],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "kinds": {
                "type": "array",
                "items": { "enum": ["dish", "story", "product", "event", "offer", "news"] }
              },
              "title": { "type": "string", "minLength": 1 },
              "body": { "type": "string", "minLength": 1 },
              "temporal": {
                "type": ["object", "null"],
                "properties": {
                  "startsAt": { "type": ["string", "null"] },
                  "endsAt": { "type": ["string", "null"] },
                  "recurs": { "enum": ["daily", "weekly", null] },
                  "status": { "enum": ["active", "upcoming", "past", "unknown"] }
                }
              },
              "authorship": { "enum": ["page", "credited"] },
              "posts": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "required": ["source"],
                  "properties": {
                    "source": { "type": "string" },
                    "id": { "type": ["string", "null"] },
                    "url": { "type": ["string", "null"] },
                    "publishedAt": { "type": ["string", "null"] }
                  }
                }
              }
            }
          }
        },
        "links": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["kind", "url", "source"],
            "properties": {
              "kind": { "enum": ["menu", "booking", "link"] },
              "url": { "type": "string" },
              "source": { "type": "string" }
            }
          }
        }
      }
    },
    "brand": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "required": ["origin", "colors"],
          "properties": {
            "origin": { "enum": ["website", "social"] },
            "official": { "type": "boolean" },
            "colors": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["hex", "role"],
                "properties": { "hex": { "type": "string" }, "role": { "type": "string" } }
              }
            },
            "fonts": { "type": "array" },
            "voice": { "type": "string" },
            "logo": { "type": "string", "description": "Asset id." },
            "logoResearch": {
              "type": "object",
              "description": "How the logo was looked for: status found | none, the chosen candidate (source, size, how it was recognised) and the others kept.",
              "properties": {
                "status": { "enum": ["found", "none"] },
                "chosen": { "type": ["object", "null"] },
                "candidates": { "type": "array" }
              }
            },
            "evidence": { "type": "array" }
          }
        }
      ]
    },
    "googlePlace": {
      "description": "Optional. Facts from the Google Places listing of the restaurant (Place Details, Atmosphere fields). Every review keeps its author: Google requires the attribution wherever a review is shown.",
      "type": "object",
      "required": ["placeId", "amenities", "summaries", "reviews", "attribution"],
      "properties": {
        "placeId": { "type": "string", "minLength": 1 },
        "amenities": { "type": "object", "additionalProperties": { "type": "boolean" } },
        "reservable": { "type": "boolean" },
        "summaries": {
          "type": "object",
          "properties": {
            "editorial": { "type": "string" },
            "generative": { "type": "string" },
            "reviews": { "type": "string" }
          }
        },
        "reviews": {
          "description": "For a person reading the brief only. Never shown on the demo (Maps terms) and never a fact about the restaurant: the markdown given to the agent and the QA judge leaves them, and summaries.reviews, out.",
          "type": "array",
          "maxItems": 5,
          "items": {
            "type": "object",
            "required": ["author", "text"],
            "properties": {
              "author": { "type": "string", "minLength": 1 },
              "authorUri": { "type": "string" },
              "authorAvatarUrl": { "type": "string" },
              "rating": { "type": "number" },
              "text": { "type": "string", "minLength": 1 },
              "language": { "type": "string" },
              "publishTime": { "type": "string" },
              "googleMapsUri": { "type": "string" }
            }
          }
        },
        "openingHours": { "type": "array", "items": { "type": "string" } },
        "priceLevel": { "type": "string" },
        "attribution": { "const": "Google" },
        "fetchedAt": { "type": "string" }
      }
    },
    "currentSite": {
      "description": "Optional. PageSpeed Insights (mobile) of the restaurant's current website: the facts a pitch compares the demo against.",
      "type": "object",
      "required": ["performance", "seo", "lcpMs", "https", "checkedAt"],
      "properties": {
        "performance": { "type": ["integer", "null"], "minimum": 0, "maximum": 100 },
        "seo": { "type": ["integer", "null"], "minimum": 0, "maximum": 100 },
        "lcpMs": { "type": ["number", "null"], "minimum": 0 },
        "https": { "type": "boolean" },
        "checkedAt": { "type": "string" }
      }
    },
    "integrations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["kind", "url", "verified"],
        "properties": {
          "kind": { "enum": ["booking", "map", "social", "chat"] },
          "url": { "type": "string", "minLength": 1 },
          "verified": { "type": "boolean" }
        }
      }
    },
    "missing": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["field", "why"],
        "properties": {
          "field": { "type": "string", "minLength": 1 },
          "why": { "type": "string", "minLength": 1 },
          "conflicting": {
            "description": "Optional. The values each source states when they disagree (opening hours): none of them is shown as fact.",
            "type": "array",
            "minItems": 2,
            "items": {
              "type": "object",
              "required": ["source", "hours"],
              "properties": {
                "source": { "type": "string", "minLength": 1 },
                "hours": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
              }
            }
          }
        }
      }
    },
    "stale": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["field", "source", "seenAt"],
        "properties": {
          "field": { "type": "string", "minLength": 1 },
          "source": { "type": "string", "minLength": 1 },
          "seenAt": { "type": "string", "minLength": 1 }
        }
      }
    },
    "assets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "kind", "category", "sha256"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "kind": { "enum": ["image", "video"] },
          "category": { "enum": ["food", "space", "event", "people", "other"] },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
        }
      }
    },
    "acceptance": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["source", "status", "coverage"],
        "properties": {
          "source": { "type": "string", "minLength": 1 },
          "status": { "enum": ["complete", "partial", "blocked", "failed"] },
          "reason": { "type": "string" },
          "coverage": {
            "type": "object",
            "properties": {
              "fetched": { "type": "integer" },
              "total": { "type": "integer" },
              "until": { "type": "string" }
            }
          }
        }
      }
    }
  }
}
